<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - HealthcareAnalytics.Web
    </title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Project CSS -->
    <link rel="stylesheet"
          href="~/HealthcareAnalytics.Web.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ============================= -->
    <!-- Navigation Bar -->
    <!-- ============================= -->

    <header>

        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Project Name -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    HealthcareAnalytics.Web

                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navbar Links -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <!-- Patients -->
                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Patients"
                               asp-action="Index">

                                Patients

                            </a>

                        </li>

                        <!-- Doctors -->
                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Doctors"
                               asp-action="Index">

                                Doctors

                            </a>

                        </li>

                        <!-- Appointments -->
                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Appointments"
                               asp-action="Index">

                                Appointments

                            </a>

                        </li>

                        <!-- Privacy -->
                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">

                                Privacy

                            </a>

                        </li>

                    </ul>

                    <!-- Right Side Buttons -->
                    <div class="d-flex">

                        <!-- Login Button -->
                        <a class="btn btn-outline-primary me-2"
                           asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                        <!-- Register Button -->
                        <a class="btn btn-primary"
                           asp-controller="Account"
                           asp-action="Register">

                            Register

                        </a>

                    </div>

                </div>

            </div>

        </nav>

    </header>

    <!-- ============================= -->
    <!-- Main Page Content -->
    <!-- ============================= -->

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- ============================= -->
    <!-- Footer -->
    <!-- ============================= -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - HealthcareAnalytics.Web

        </div>

    </footer>

    <!-- ============================= -->
    <!-- Scripts -->
    <!-- ============================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
                        