@model HealthcareAnalytics.Web.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>

<h3>Are you sure you want to delete this appointment?</h3>

<hr />

<!-- Appointment Details -->
<dl class="row">

    <dt class="col-sm-3">
        Patient ID
    </dt>

    <dd class="col-sm-9">
        @Model.PatientId
    </dd>

    <dt class="col-sm-3">
        Doctor ID
    </dt>

    <dd class="col-sm-9">
        @Model.DoctorId
    </dd>

    <dt class="col-sm-3">
        Appointment Date
    </dt>

    <dd class="col-sm-9">
        @Model.AppointmentDate
    </dd>

    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

    <dt class="col-sm-3">
        Notes
    </dt>

    <dd class="col-sm-9">
        @Model.Notes
    </dd>

</dl>

<!-- Delete Form -->
<form asp-action="Delete">

    <!-- Hidden Appointment ID -->
    <input type="hidden"
           asp-for="AppointmentId" />

    <!-- Delete Button -->
    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    |

    <!-- Back Button -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

</form>