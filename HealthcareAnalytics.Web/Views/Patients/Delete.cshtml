@model HealthcareAnalytics.Core.Entities.Patient

@{
    ViewData["Title"] = "Delete Patient";
}

<h1>Delete Patient</h1>

<h3>Are you sure you want to delete this patient?</h3>

<hr />

<div>

    <dl class="row">

        <dt class="col-sm-3">
            Full Name
        </dt>

        <dd class="col-sm-9">
            @Model.FullName
        </dd>

        <dt class="col-sm-3">
            Gender
        </dt>

        <dd class="col-sm-9">
            @Model.Gender
        </dd>

        <dt class="col-sm-3">
            Age
        </dt>

        <dd class="col-sm-9">
            @Model.Age
        </dd>

        <dt class="col-sm-3">
            Phone
        </dt>

        <dd class="col-sm-9">
            @Model.Phone
        </dd>

        <dt class="col-sm-3">
            Address
        </dt>

        <dd class="col-sm-9">
            @Model.Address
        </dd>

    </dl>

    <!-- Delete Form -->

    <form asp-action="Delete">

        <input type="hidden" asp-for="PatientId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </form>

</div>