@model HealthcareAnalytics.Core.Entities.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<h1 class="text-danger mb-4">Delete Doctor</h1>

<h4>
    Are you sure you want to delete this doctor?
</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Doctor Name
    </dt>

    <dd class="col-sm-9">
        @Model.Name
    </dd>

    <dt class="col-sm-3">
        Specialization
    </dt>

    <dd class="col-sm-9">
        @Model.Specialization
    </dd>

    <dt class="col-sm-3">
        Experience
    </dt>

    <dd class="col-sm-9">
        @Model.Experience Years
    </dd>

</dl>

<form asp-action="Delete">

    <input asp-for="DoctorId" type="hidden" />

    <button type="submit"
            class="btn btn-danger">

        Delete

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>

</form>