@model HealthcareAnalytics.Core.Entities.Doctor

@{
    ViewData["Title"] = "Edit Doctor";
}

<h1 class="mb-4">Edit Doctor</h1>

<form asp-action="Edit" method="post">

    <!-- Hidden Doctor ID -->
    <input asp-for="DoctorId" type="hidden" />

    <!-- Doctor Name -->
    <div class="form-group mb-3">

        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>

    </div>

    <!-- Specialization -->
    <div class="form-group mb-3">

        <label asp-for="Specialization"
               class="form-label">
        </label>

        <input asp-for="Specialization"
               class="form-control" />

        <span asp-validation-for="Specialization"
              class="text-danger">
        </span>

    </div>

    <!-- Experience -->
    <div class="form-group mb-3">

        <label asp-for="Experience"
               class="form-label">
        </label>

        <input asp-for="Experience"
               class="form-control" />

        <span asp-validation-for="Experience"
              class="text-danger">
        </span>

    </div>

    <!-- Update Button -->
    <button type="submit"
            class="btn btn-warning">

        Update Doctor

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Back

    </a>

</form>