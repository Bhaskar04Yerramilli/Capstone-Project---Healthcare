@model IEnumerable<HealthcareAnalytics.Core.Entities.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<!-- ========================================= -->
<!-- Doctors Heading -->
<!-- ========================================= -->

<h1 class="mb-4">Doctors List</h1>

<!-- ========================================= -->
<!-- Search Bar -->
<!-- ========================================= -->

<form method="get"
      asp-action="Index"
      class="mb-3">

    <div class="row">

        <!-- Search Input -->
        <div class="col-md-4">

            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search by doctor name or specialization..." />

        </div>

        <!-- Search Button -->
        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-success">

                Search

            </button>

        </div>

        <!-- Clear Button -->
        <div class="col-md-2">

            <a asp-action="Index"
               class="btn btn-secondary">

                Clear

            </a>

        </div>

    </div>

</form>

<!-- ========================================= -->
<!-- Add Doctor Button -->
<!-- ========================================= -->

<a asp-action="Create"
   class="btn btn-primary mb-3">

    Add New Doctor

</a>

<!-- ========================================= -->
<!-- Doctors Table -->
<!-- ========================================= -->

<table class="table table-bordered table-striped">

    <thead class="table-dark">

        <tr>

            <th>Doctor ID</th>

            <th>Name</th>

            <th>Specialization</th>

            <th>Experience</th>

            <th>Actions</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <!-- Doctor Details -->

                <td>@item.DoctorId</td>

                <td>@item.Name</td>

                <td>@item.Specialization</td>

                <td>@item.Experience Years</td>

                <!-- Action Buttons -->

                <td>

                    <!-- Edit Button -->

                    <a asp-action="Edit"
                       asp-route-id="@item.DoctorId"
                       class="btn btn-warning btn-sm">

                        Edit

                    </a>

                    <!-- Delete Button -->

                    <a asp-action="Delete"
                       asp-route-id="@item.DoctorId"
                       class="btn btn-danger btn-sm">

                        Delete

                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>